; Prototipo aislado. No cambia el proyecto del laboratorio.
config_version=5

[application]
config/name="Prototipo de sincronización de objetos"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1100
window/size/viewport_height=700

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.09, 0.11, 0.15, 1)

[physics]
3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/penetration_slop=0.002
common/physics_interpolation=false
