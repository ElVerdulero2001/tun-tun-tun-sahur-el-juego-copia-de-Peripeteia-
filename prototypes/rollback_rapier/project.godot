; Fuente del ensayo. Preparar una copia aislada con prepare_rapier_probe.ps1.
config_version=5

[application]
config/name="Tun-tun: rollback capability probe"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[physics]
3d/physics_engine="Rapier3D"
3d/run_on_separate_thread=false
common/physics_interpolation=false
