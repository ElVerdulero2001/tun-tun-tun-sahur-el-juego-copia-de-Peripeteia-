[node name="NetLab" type="Node3D"]
script = ExtResource("1_lab")

[node name="Level" parent="." instance=ExtResource("2_level")]

[node name="Actors" type="Node3D" parent="."]

[node name="ActorSpawner" type="MultiplayerSpawner" parent="."]
